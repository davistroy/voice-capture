# Voice Capture to Notion Pipeline - Environment Variables
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env to version control

# =============================================================================
# API KEYS (Required)
# =============================================================================

# OpenAI API Key - for Whisper transcription
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API Key - for Claude classification
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Notion API Key - for storing captures
# Get from: https://www.notion.so/my-integrations
NOTION_API_KEY=secret_your-notion-api-key-here

# Pushover Keys - for notifications (optional but recommended)
# Get from: https://pushover.net
PUSHOVER_API_TOKEN=your-pushover-app-token-here
PUSHOVER_USER_KEY=your-pushover-user-key-here

# =============================================================================
# NOTION DATABASE IDS (Required)
# =============================================================================

# Voice Captures Database ID
# Get from: Open database in Notion, copy the ID from the URL
# URL format: https://notion.so/{workspace}/{database_id}?v=...
NOTION_VOICE_CAPTURES_DB_ID=your-voice-captures-database-id-here

# Weekly Summaries Database ID
NOTION_WEEKLY_SUMMARIES_DB_ID=your-weekly-summaries-database-id-here

# =============================================================================
# PATH CONFIGURATION (Optional - defaults for Docker)
# =============================================================================

# Uncomment and modify for local development or custom deployment
# VOICE_CAPTURE_INBOX_PATH=/home/user/voice-capture/inbox
# VOICE_CAPTURE_PROCESSING_PATH=/home/user/voice-capture/processing
# VOICE_CAPTURE_FAILED_PATH=/home/user/voice-capture/failed
# VOICE_CAPTURE_DB_PATH=/home/user/voice-capture/data/voice_capture.db
# VOICE_CAPTURE_LOG_PATH=/home/user/voice-capture/logs

# =============================================================================
# LOGGING (Optional)
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
VOICE_CAPTURE_LOG_LEVEL=INFO

# =============================================================================
# MODEL CONFIGURATION (Optional)
# =============================================================================

# Whisper model (default: whisper-1)
# WHISPER_MODEL=whisper-1

# Claude model for classification
# CLAUDE_MODEL=claude-sonnet-4-20250514

# Classification confidence threshold (0.0-1.0)
# CLASSIFICATION_CONFIDENCE_THRESHOLD=0.7

# =============================================================================
# PIPELINE CONFIGURATION (Optional)
# =============================================================================

# Maximum retry attempts for failed operations
# MAX_RETRIES=3

# Delay to wait for file write completion (seconds)
# FILE_SETTLE_DELAY_SECONDS=2.0

# =============================================================================
# RCLONE CONFIGURATION (Optional)
# =============================================================================

# Sync interval in seconds (default: 180)
RCLONE_SYNC_INTERVAL=180
